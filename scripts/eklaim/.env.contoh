# Salin berkas ini menjadi ".env" (di folder yang sama), lalu isi.
# JANGAN kirim isi .env lewat chat / email / WhatsApp, dan jangan di-commit.

# Alamat server E-Klaim di jaringan RS (tanpa /E-Klaim/ws.php di belakang).
EKLAIM_URL=http://192.168.x.x

# Encryption key Web Service E-Klaim: menu Setup / Integrasi SIMRS di E-Klaim.
EKLAIM_KEY=

# Isi 1 hanya bila E-Klaim memang dijalankan dalam mode debug (tanpa enkripsi).
EKLAIM_DEBUG=0
