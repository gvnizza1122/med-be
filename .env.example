# ===== DATABASE =====
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# ===== JWT (WAJIB ganti dengan string acak) =====
JWT_SECRET=
JWT_REFRESH_SECRET=

# ===== DOMAIN / IP SERVER =====
DOMAIN=
CORS_ORIGIN=
PORT=

# ===== AI PROVIDER (isi sesuai provider yang dipilih) =====
# OpenAI
# AI_API_KEY=sk-your-openai-key
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# OpenRouter
# AI_API_KEY=sk-or-your-key
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=openrouter/auto

# Anthropic
# AI_API_KEY=
# AI_BASE_URL=https://api.anthropic.com/v1
# AI_MODEL=claude-3-haiku-20240307

# Ollama (lokal)
# AI_API_KEY=ollama
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.2:3b

AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-6-luna
AI_REVIEW_MODEL=gpt-6.1-sol
AI_HYBRID_SOL_ENABLED=true
# Sampel hasil awal yang jelas; kasus ambigu selalu ditinjau, tanpa kuota 20%.
AI_SOL_SAMPLE_PERCENT=5
AI_USD_IDR=18000

# ===== KIMI K3 / MOONSHOT (khusus pipeline training RAG, terpisah dari AI review klaim utama) =====
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3
KIMI_TIMEOUT_MS=60000

# ===== BRIDGING API =====
SIMRS_API_KEY=
SIMRS_CALLBACK_URL=
SIMRS_CALLBACK_API_KEY=

# ===== OCR ENHANCEMENT (Phase 1: critical page prioritization) =====
# Batas keras total waktu OCR enhancement (Tesseract multi-pass) per file.
# Halaman TRIAGE IGD/RESUME MEDIS diprioritaskan diproses duluan; halaman
# lain di-skip kalau budget ini mepet (lihat ocrService.js/ocrIntegration.js).
OCR_ENHANCEMENT_TIMEOUT=300000

# Pagar pasca-AI (saran kode). Bawaan semua ON; isi 0/false untuk mematikan.
# PAGAR_TEMUAN_AKTIF=1
# PAGAR_KUTIPAN_AKTIF=1
# PAGAR_NEGASI_AKTIF=1
# PAGAR_PERAN_AKTIF=1
# PAGAR_TULISAN_TANGAN_AKTIF=1
# PAGAR_KAMUS_PENUNJANG_AKTIF=1
# PETUNJUK_RESEP_AKTIF=1
# PAGAR_OCR_AMBANG_CEK=70
